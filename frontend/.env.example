# Frontend environment. Copy to .env.local for local overrides.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.
# Never put a secret in here: everything below ships to the client.

# Base URL of the PlayHub API.
# Empty means same origin, which is correct for both `npm run dev` (the Vite
# proxy forwards /api) and the Docker setup (nginx forwards /api).
VITE_API_BASE_URL=

# Client-side request timeout in milliseconds.
VITE_API_TIMEOUT_MS=10000

# Where the Vite dev server proxies /api during `npm run dev`.
# Use http://localhost:8080 when the backend runs on the host.
VITE_DEV_API_PROXY=http://localhost:8080
