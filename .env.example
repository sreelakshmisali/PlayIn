# PlayHub environment configuration.
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
#
# .env is git-ignored. Never commit real credentials. Everything here is read
# by docker-compose.yml and passed to the containers as environment variables.

# --- application -------------------------------------------------------------
# development | staging | production
APP_ENV=development
# debug | info | warn | error
LOG_LEVEL=debug
# Stamped into the API binary and reported by /api/v1/health.
APP_VERSION=dev

# --- database ----------------------------------------------------------------
# Used by both the postgres container and the api container.
DB_USER=playhub
DB_PASSWORD=change_me_locally
DB_NAME=playhub
DB_SSLMODE=disable

# --- auth --------------------------------------------------------------------
# Signs and verifies JWTs. No default: an application that falls back to a
# built-in key issues forgeable tokens. At least 32 characters.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_to_at_least_32_random_characters
# Appears as the iss claim and is checked on every token.
JWT_ISSUER=playhub
# Access tokens are short lived; refresh tokens are revocable server side.
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
# bcrypt work factor. Higher is slower to brute force and slower to log in with.
BCRYPT_COST=12

# --- host port mappings ------------------------------------------------------
# Change these if a port is already taken on your machine.
DB_PORT_HOST=5432
API_PORT_HOST=8080
WEB_PORT_HOST=3000

# --- api ---------------------------------------------------------------------
# Browser origins allowed to call the API directly. Comma separated.
# The nginx container serves the frontend on the same origin as the API, so
# this only matters for the Vite dev server.
HTTP_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- frontend ----------------------------------------------------------------
# Baked into the bundle at build time. Empty means same origin, which is what
# the nginx proxy provides. Only set this if the API is on another host.
VITE_API_BASE_URL=
