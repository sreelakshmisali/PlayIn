# The Go API's origin (scheme + host + port, no path). Read by services/config.ts
# via Expo's built-in EXPO_PUBLIC_ env var inlining — copy this file to .env and
# set the right value for how you're running the app. See README.md for the
# full explanation of why "localhost" does not work on a physical device or
# a real Android emulator.

# iOS Simulator only (shares the Mac's network stack):
# EXPO_PUBLIC_API_URL=http://localhost:8080

# Android emulator (10.0.2.2 is the emulator's alias for the host machine;
# this is also the built-in default in services/config.ts, so it works even
# without a .env file):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8080

# Physical device over Expo Go / a dev build, on the same Wi-Fi as your
# development machine — replace with your machine's actual LAN IP:
EXPO_PUBLIC_API_URL=http://192.168.1.100:8080
