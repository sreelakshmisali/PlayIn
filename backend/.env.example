# Backend environment for running the API directly on the host:
#   cd backend && cp .env.example .env
#   set -a && . ./.env && set +a && go run ./cmd/api
#
# Under Docker Compose these values come from the root .env instead.
# .env is git-ignored. Never commit real credentials.

APP_ENV=development
LOG_LEVEL=debug

HTTP_HOST=0.0.0.0
HTTP_PORT=8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=20s
HTTP_IDLE_TIMEOUT=120s
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_ALLOWED_ORIGINS=http://localhost:5173

# localhost, because the postgres container publishes 5432 to the host.
DB_HOST=localhost
DB_PORT=5432
DB_USER=playhub
DB_PASSWORD=change_me_locally
DB_NAME=playhub
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
DB_CONNECT_TIMEOUT=5s

# --- auth --------------------------------------------------------------------
# Required. At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET=change_me_to_at_least_32_random_characters
JWT_ISSUER=playhub
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
BCRYPT_COST=12
